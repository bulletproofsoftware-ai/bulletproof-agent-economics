# =============================================================================
# Agent Economics System — Environment Configuration
# =============================================================================

# --- PostgreSQL (Supabase) ---
# Use a strong password — do not commit real credentials
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Governance Audit Bus ---
AUDIT_DB_PATH=./data/audit.db

# --- Qdrant ---
QDRANT_URL=http://localhost:6334

# --- Ollama (for embeddings) ---
OLLAMA_URL=http://localhost:11434

# --- Event Router ---
EVENT_ROUTER_URL=http://localhost:8085
EVENT_ROUTER_EMIT_TIMEOUT_MS=500

# --- Server ---
ECONOMICS_PORT=8097
ECONOMICS_JWT_SECRET=
ECONOMICS_JWT_ISSUER=agent-economics
ECONOMICS_JWT_MAX_AGE=1h

# --- Metrics Windows ---
ACTIVE_AGENT_WINDOW_MINUTES=15
COST_RATE_WINDOW_MINUTES=15

# --- Dashboard ---
DASHBOARD_PORT=8098
VITE_ECONOMICS_API_URL=http://localhost:8097
VITE_ECONOMICS_WS_URL=ws://localhost:8097/economics/stream

# --- Budget Defaults ---
BUDGET_THRESHOLD_MONITOR_PCT=60
BUDGET_THRESHOLD_WARN_PCT=80
BUDGET_THRESHOLD_THROTTLE_PCT=90
BUDGET_THRESHOLD_PAUSE_PCT=100

# --- Anomaly Detection ---
ANOMALY_MULTIPLIER_THRESHOLD=10
ANOMALY_BASELINE_WINDOW_DAYS=7

# --- Cache TTLs ---
CACHE_TTL_PROMPT_MINUTES=5
CACHE_TTL_SEMANTIC_HOURS=24
CACHE_TTL_TOOL_RESPONSE_MINUTES=60
CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.95

# --- Model Pricing (cents per 1M tokens) ---
PRICING_HAIKU_INPUT=80
PRICING_HAIKU_OUTPUT=400
PRICING_HAIKU_CACHE=8
PRICING_SONNET_INPUT=300
PRICING_SONNET_OUTPUT=1500
PRICING_SONNET_CACHE=30
PRICING_OPUS_INPUT=1500
PRICING_OPUS_OUTPUT=7500
PRICING_OPUS_CACHE=150

# --- ROI Defaults ---
ROI_DEVELOPER_RATE_CENTS_PER_HOUR=15000
ROI_HOURS_PER_STORY_POINT=4

# --- Alert Channels ---
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=economics@bulletproofsoftware.tech
ALERT_EMAIL_RECIPIENTS=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
